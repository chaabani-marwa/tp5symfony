{% extends 'base.html.twig' %}

{% block title %}Catalogue de livres{% endblock %}

{% block body %}
<div class="row">
    <div class="col-md-12">
        <h1 class="mb-4">Catalogue de livres</h1>
    </div>
</div>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    {% for livre in livres %}
        <div class="col">
            <div class="card h-100 shadow-sm">
                <img src="{{ livre.image }}" class="card-img-top" alt="{{ livre.titre }}" style="height: 250px; object-fit: cover;">
                <div class="card-body">
                    <h5 class="card-title">{{ livre.titre }}</h5>
                    <p class="card-text text-muted">{{ livre.editeur }}</p>
                    <p class="card-text">
                        <small class="text-secondary">{{ livre.resume|slice(0, 100) }}...</small>
                    </p>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="h6 mb-0">{{ livre.prix }} DT</span>
                        <span class="badge bg-info">{{ livre.categorie.libelle }}</span>
                    </div>
                </div>
                <div class="card-footer bg-white border-top">
                    <a href="{{ path('app_livres_detail', {'id': livre.id}) }}" class="btn btn-primary btn-sm w-100 mb-2">Voir détails</a>
                    <a href="{{ path('app_cart_add', {'id': livre.id}) }}" class="btn btn-success btn-sm w-100">🛒 Ajouter au panier</a>
                </div>
            </div>
        </div>
    {% endfor %}
</div>

<div class="mt-4">
    <div class="navigation">
        {{ knp_pagination_render(livres) }}
    </div>
</div>
{% endblock %}
