{% extends 'base.html.twig' %}

{% block title %}Mon Panier{% endblock %}

{% block body %}
<div class="row mb-4">
    <div class="col-md-12">
        <h1 class="mb-3">Mon Panier</h1>
    </div>
</div>

{% if cart is empty %}
    <div class="alert alert-info">
        <p>Votre panier est vide.</p>
        <a href="{{ path('app_livres_catalogue') }}" class="btn btn-primary">Continuer vos achats</a>
    </div>
{% else %}
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <table class="table table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Produit</th>
                        <th>Prix unitaire</th>
                        <th style="width: 100px;">Quantité</th>
                        <th>Total</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    {% for livreId, item in cart %}
                        <tr>
                            <td>
                                <img src="{{ item.image }}" alt="{{ item.titre }}" style="width: 50px; height: 50px; object-fit: cover;" class="me-2">
                                <a href="{{ path('app_livres_detail', {'id': item.id}) }}">{{ item.titre }}</a>
                            </td>
                            <td>{{ item.prix }} DT</td>
                            <td>
                                <form method="POST" action="#" class="d-inline">
                                    <input type="number" class="form-control form-control-sm" value="{{ item.quantity }}" style="width: 60px;" disabled>
                                </form>
                            </td>
                            <td><strong>{{ (item.prix * item.quantity)|number_format(2, '.', '') }} DT</strong></td>
                            <td>
                                <a href="{{ path('app_cart_remove', {'id': item.id}) }}" class="btn btn-danger btn-sm" onclick="return confirm('Êtes-vous sûr ?')">
                                    <span>✕</span>
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <a href="{{ path('app_livres_catalogue') }}" class="btn btn-secondary">← Continuer vos achats</a>
        </div>
        <div class="col-md-6 text-end">
            <div class="card bg-light">
                <div class="card-body">
                    <h5 class="card-title">Résumé du panier</h5>
                    <hr>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Subtotal :</span>
                        <span>{{ total }} DT</span>
                    </div>
                    <h4 class="text-primary">Total : {{ total }} DT</h4>
                    <hr>
                    <a href="{{ path('app_cart_checkout') }}" class="btn btn-success w-100 mb-2">Valider la commande</a>
                    <a href="{{ path('app_cart_clear') }}" class="btn btn-outline-danger w-100" onclick="return confirm('Êtes-vous sûr de vouloir vider le panier ?')">Vider le panier</a>
                </div>
            </div>
        </div>
    </div>
{% endif %}
{% endblock %}
